#!/bin/sh
# pre-push 门禁：行为门禁 + 类型门禁两套，各自独立开关。
#
# 装法（必须每个 clone / worktree 各跑一次，hook 不随 clone 分发）:
#     git config core.hooksPath .githooks
# 用 core.hooksPath 而不是往 .git/hooks 里拷文件，这样 hook 本身是【版本化】的。
#
# 拦得住：本机 push 出去的行为回归与类型回归。
# 拦不住：git push --no-verify；别人机器上没跑过 git config 的；
#         直接在服务端/网页端改的；以及任何非 push 路径。
# 所以这道 hook 只是「早失败」，真闸门在 scripts/build.js 的 release 前置。
#
# ⚠ 两个开关是【分离】的，别用一个去关另一个：
#     SKIP_TESTS=1      只跳过行为门禁
#     SKIP_TYPECHECK=1  只跳过类型门禁（后缀并存 + 语法 + 语义差分）
#   历史缺陷：SKIP_TYPECHECK=1 曾经 `exit 0` 掉整个 hook，导致行为门禁被静默一并关掉，
#   而且不给任何提示。用文档里那个逃生口的人会在毫不知情的情况下失去行为门禁。
#   修法就是下面这个顺序——行为门禁在任何早退之前执行。
set -e

# ── 前置：node_modules 与 package.json 是否对得上 ──────────────────────────
# 为什么值得单开一条：合并完依赖升级分支之后，主检出的代码是新的、node_modules
# 还是旧的。这时语义差分会吐出几十条【指向业务文件】的类型错
#（实际见过的：react-dnd 16 的代码撞上 v11 的 DragObjectWithType；
#  chalk 6 的代码撞上 v4 → `Cannot read properties of undefined (reading 'gray')`），
# 看起来像是代码写错了，其实一条都不是。连栽两次，所以在最前面直接说清楚。
# 用 yarn 自己的完整性记录判断，不自己造轮子；yarn 不在或记录缺失时不拦（只提示）。
if command -v yarn > /dev/null 2>&1 && [ -f node_modules/.yarn-integrity ]; then
  if ! yarn check --integrity > /dev/null 2>&1; then
    echo "pre-push: !! node_modules 与 package.json/yarn.lock 不一致。"
    echo "           先跑 yarn install 再 push —— 否则下面的类型门禁会报出一堆"
    echo "           指向业务文件、但其实是版本不匹配造成的假错误。"
    exit 1
  fi
fi

# ── 行为门禁 ─────────────────────────────────────────────────────────────
# 放最前面：只要约 4s，比语义差分快 7 倍，绝大多数行为回归能在 4 秒内失败，
# 不用等后面那 31 秒。
#
# 覆盖面很窄，别高估：87 个源文件 / 全仓 2.0%，src/api 覆盖为 0。
# 变异测试实测——断言直接覆盖的逻辑杀死率 95.7%，但同一文件内其它位置只有 16.7%。
# 也就是说它守的是「这些文件里被断言点到的那几十行」，不是「这些文件」。
# 它是「改这几处别改坏」的护栏，不是重构安全网。
if [ "$SKIP_TESTS" = "1" ]; then
  echo "pre-push: SKIP_TESTS=1，跳过行为门禁"
else
  echo "pre-push: 行为门禁（约 4s）..."
  node scripts/run-specs.js
fi

# ── 类型门禁 ─────────────────────────────────────────────────────────────
if [ "$SKIP_TYPECHECK" = "1" ]; then
  echo "pre-push: SKIP_TYPECHECK=1，跳过类型门禁（行为门禁已在上面执行）"
  exit 0
fi

echo "pre-push: 后缀并存检查（约 1s）..."
node scripts/checkExtensionCollisions.js

echo "pre-push: 语法门禁（约 8s）..."
NODE_OPTIONS=--max_old_space_size=8192 node scripts/typecheck/tsc-syntax-gate.js

echo "pre-push: 语义差分门禁（冷跑，约 30s）..."
NODE_OPTIONS=--max_old_space_size=8192 node scripts/typecheck/tsc-gate.js --no-incremental
