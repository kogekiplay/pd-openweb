#!/bin/sh
# 类型门禁 pre-push hook。
#
# 装法（必须每个 clone / worktree 各跑一次，hook 不随 clone 分发）:
#     git config core.hooksPath .githooks
# 用 core.hooksPath 而不是往 .git/hooks 里拷文件，这样 hook 本身是【版本化】的。
#
# 拦得住：本机 push 出去的类型回归。
# 拦不住：git push --no-verify；别人机器上没跑过 git config 的；
#         直接在服务端/网页端改的；以及任何非 push 路径。
# 所以这道 hook 只是「早失败」，真闸门在 scripts/build.js 的 release 前置。
set -e

if [ "$SKIP_TYPECHECK" = "1" ]; then
  echo "pre-push: SKIP_TYPECHECK=1，跳过类型门禁"
  exit 0
fi

echo "pre-push: 后缀并存检查（约 1s）..."
node scripts/checkExtensionCollisions.js

echo "pre-push: 语法门禁（约 8s）..."
NODE_OPTIONS=--max_old_space_size=8192 node scripts/typecheck/tsc-syntax-gate.js

echo "pre-push: 语义差分门禁（冷跑，约 30s）..."
NODE_OPTIONS=--max_old_space_size=8192 node scripts/typecheck/tsc-gate.js --no-incremental
