// 宽松基线（tsc 测量用）。
// 构建链完全不读这份文件：CI/webpack.config.js:94 走 babel-loader（纯类型擦除），
// 全仓无 ts-loader / fork-ts-checker，所以「webpack 绿」和「tsc 干净」是两件独立的事。
{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    // 用 classic（"react"）而不是 "react-jsx"：.babelrc 的 @babel/preset-react 没配
    // runtime，babel 7 默认即 classic；eslint.config.js 也把 react/react-in-jsx-scope
    // 设为 error，说明全仓 JSX 文件都显式 import React。React 运行时 18.3.1。
    // 选 "react-jsx" 会与真实构建产物不一致。
    "jsx": "react",

    "allowJs": true,
    "checkJs": false,
    "noEmit": true,

    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,

    // R1 配对开关：.babelrc 的 onlyRemoveTypeImports:true 会把
    // `import { SomeType } from './x'` 原样保留到产物；verbatimModuleSyntax 用 TS1484
    // 强制这类写法改成 `import type`，把洞补上。
    "verbatimModuleSyntax": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": false,
    "experimentalDecorators": true,

    // TS 7 不再像 5.x 那样自动把 node_modules/@types/* 全都纳入全局。
    // 不写这一条，全仓 require() 会报 TS2591、NodeJS.Timeout 会报 TS2694。
    // 只列 node：其余 @types 包（d3 / color-convert / ...）都是【按模块导入】
    // 使用的，不提供全局声明，不需要出现在这里。
    "types": ["node"],
    "paths": {
      // 保留 jsconfig.json 原有的 4 条 alias（5 个 key）。
      // 注意 webpack 侧 resolve.alias（CI/webpack.config.js:419-423）只有
      // worksheet / mobile / statistics 三条，ming-ui 是靠 resolve.modules 的
      // PATHS.src 解析的；这里显式写出，效果等价。
      // styled-components 6 自带完整类型，但本仓在 4.4.1 时代从未装过
      // @types/styled-components（styled 一直是隐式 any）。直接启用会新增
      // 5633 条原始诊断，那是一件独立的大工程。这里把它指向本仓的下限声明，
      // 维持升级前的类型精度；撤销方式见 types/styled-components.d.ts 文件头。
      "styled-components": ["./types/styled-components.d.ts"],
      "ming-ui": ["./src/ming-ui"],
      "ming-ui/*": ["./src/ming-ui/*"],
      "worksheet/*": ["./src/pages/worksheet/*"],
      "mobile/*": ["./src/pages/Mobile/*"],
      "statistics/*": ["./src/pages/Statistics/*"],

      // 镜像 CI/webpack.config.js:425 的
      //   resolve.modules: [PATHS.root, PATHS.src, 'node_modules']
      // webpack 能把裸路径 'src/api/x'（1305 处）和 'api/x'（19 处）都解析掉，
      // tsc 没有等价机制。没这一条会产生大批「webpack 绿但 tsc 报 TS2307」的假故障。
      // paths 匹配失败时 tsc 会回落到 node_modules 解析，所以不会挡住 npm 包。
      "*": ["./src/*", "./*"]
    }
  },

  // types/ 在 src 之外，必须显式列出（改成整目录纳入，新增 .d.ts 无需再动这里）。
  "include": ["src", "types"],

  // src/library 是预打包的压缩产物（applibrary_v2.js 等单行数 MB），
  // 与 jsconfig.json 原有 exclude 保持一致。
  // src/library 是预打包的压缩产物（applibrary_v2.js 等单行数 MB）。
  // *.spec.ts 交给 tsconfig.tools.json 的零容忍门禁管，理由见那边的注释。
  "exclude": [
    "node_modules",
    "src/library",
    "src/**/*.spec.ts",
    // DevelopWithAI 的 default_* 是【示例源码素材】不是模块：从不被 import，
    // 由同目录的 gen 读成字符串喂给 AI。它们故意不写 import（只展示组件本体），
    // 当代码检查必然报「找不到 useState」——那是素材的本意，不是缺陷。
    "src/**/DevelopWithAI/examples/default_*",
    // 这两个是【跑在 Node 里的工具脚本】，只是和数据放在一起：gen 生成示例字符串、
    // Func/test 载入构建产物跑函数测试。它们用 CJS require，顶层 const 在 src 的
    // ESM 口径下会变成全局声明并与别处撞名（TS2451）。交给 tsconfig.tools.json。
    "src/**/DevelopWithAI/examples/gen.tsx",
    "src/**/FunctionEditorDialog/Func/test/index.ts"
  ]
}
