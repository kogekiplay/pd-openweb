// 工具链自身的类型检查（scripts/ 与 tools/）。
//
// 【为什么要单开一份】根 tsconfig.json 的 include 只有 ["src","types"]，
// 门禁脚本、codemod、构建脚本【一条都不在里面】。2026-09-15 把
// scripts/typecheck/*.js 改名成 .ts 时才意识到：光改后缀而不纳入任何 tsconfig，
// 写的类型标注一个字都不会被验证，纯装饰。
//
// 【为什么不直接并进根 tsconfig】两边的形态不一样，混在一起两头难受：
//   · src 是浏览器代码（lib 要 DOM、module 是 ESNext、走 webpack alias）；
//     工具链是 Node 脚本（require/module.exports、__dirname、process）。
//   · 更要紧的是差分门禁的基线是按根 tsconfig 的诊断多重集算的。把几十个
//     工具文件塞进去会一次性改变基线口径，之后再也说不清某条诊断的来源。
//
// 【口径】和根 tsconfig 一样是宽松基线：不开 strict、不开 noImplicitAny。
// 目的是「标注写错了要报错」，不是「一次把工具链也 strict 化」——后者是另一件事。
{
  "compilerOptions": {
    "target": "ES2022",
    // 【故意不带 DOM】工具链跑在 Node 里。spec 模拟浏览器环境用的那几个全局，
    // 走 types/spec-globals.d.ts 一处声明，理由写在那个文件头。
    "lib": ["ES2022"],

    // 工具链是 CommonJS：全部 require/module.exports。
    // Node 26 按「有没有 ESM 语法」判断 .ts 的模块类型，写 export 就会被当 ESM，
    // 届时 module.exports 直接 ReferenceError。这里的配置与运行时保持一致。
    "module": "NodeNext",
    "moduleResolution": "nodenext",

    // 【allowJs 已移除】实测（tsc --listFiles）这份配置的程序里一个 .js 都没有，
    // 它一直是死配置。scripts/iconViewer/lib/toast.js 是被 HTML 用 <script src>
    // 直接喂浏览器的，从来不进 TS 程序。
    "noEmit": true,

    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },

  // 只收 .ts。目录下若还有 .js，它们不进这个程序（也不该进）；
  // 新写的脚本一律 .ts，放进来【自动】受检查，不用再动这里。
  // 根目录那两个配置文件（.prettierrc.ts / eslint.config.ts）也显式列进来。
  "include": [
    "scripts/**/*.ts",
    "tools/**/*.ts",
    "CI/**/*.ts",
    ".prettierrc.ts",
    "eslint.config.ts",
    // src 下的 spec 也归这里：它们【从不静态 import 被测模块】，一律用
    // spec-harness 的 transformFileSync 动态载入，所以是自包含的 Node 脚本，
    // 不需要 src 那套 DOM lib / webpack alias。根 tsconfig 里对应地把它们排除掉，
    // 否则 69 个 spec 的诊断会一次性挤进差分门禁的基线，之后再也分不清来源。
    "src/**/*.spec.ts",
    // src 里少数「跑在 Node 里的工具脚本」，口径和 spec 一样归这边
    "src/**/DevelopWithAI/examples/gen.tsx",
    "src/**/FunctionEditorDialog/Func/test/index.ts",
    // spec 模拟浏览器环境用的全局（window / location / document / md），
    // 有界放宽，理由见该文件头
    "types/spec-globals.d.ts"
  ],
  // tools/ 下有几个【跑在浏览器里】的预览/验证页，它们要 DOM lib，
  // 而这份配置故意不带 DOM（见上）。硬塞进来会把 DOM 全局带给上面那批 spec，
  // 导致 19 条「window.origin 只读」之类的假错误 —— 实测过。
  // 它们收在 tsconfig.tools.browser.json，同样受第 6 道门禁检查，不是豁免。
  "exclude": ["node_modules", "tools/fc7-preview/entry.tsx", "tools/verify-jquery-bugfixes/entry.ts"]
}
