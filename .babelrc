{
  "plugins": [
    "@babel/plugin-transform-runtime",
    [
      "import",
      {
        "libraryName": "ming-ui/functions",
        "libraryDirectory": "",
        "camel2DashComponentName": false
      },
      "import-ming-ui-functions"
    ],
    [
      "import",
      {
        "libraryName": "ming-ui/antd-components",
        "libraryDirectory": "",
        "camel2DashComponentName": false
      },
      "import-ming-ui-antd-components"
    ],
    [
      "import",
      {
        "libraryName": "ming-ui",
        "libraryDirectory": "components",
        "camel2DashComponentName": false
      },
      "import-ming-ui"
    ]
  ],
  "env": {
    "development": {
      "plugins": ["babel-plugin-dynamic-import-node"],
      "presets": [
        [
          "@babel/preset-env",
          {
            "modules": false,
            "targets": {
              "chrome": "103"
            }
          }
        ],
        [
          "@babel/preset-react",
          {
            "runtime": "automatic"
          }
        ],
        [
          "@babel/preset-typescript",
          {
            "onlyRemoveTypeImports": true
          }
        ]
      ]
    },
    "production": {
      "presets": [
        [
          "@babel/preset-env",
          {
            "modules": false,
            "targets": {
              "chrome": "103"
            }
          }
        ],
        [
          "@babel/preset-react",
          {
            "runtime": "automatic"
          }
        ],
        [
          "@babel/preset-typescript",
          {
            "onlyRemoveTypeImports": true
          }
        ]
      ]
    }
  }
}
