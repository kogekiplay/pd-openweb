// 全仓 TS 终点测量档。文件集、paths、jsx 与正式产品程序一致。
// 与 scripts/typecheck/tsc-strict-gate.ts 的 TARGET_FLAGS 保持相同检查口径。
// 正式 tsconfig.json 尚有存量诊断；本档不表示已经完成严格化。
// node node_modules/@typescript/native/bin/tsc -p tsconfig.strict.json --noEmit --pretty false
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true
  }
}
